# Copy this file to ".env" and fill in your own values. ".env" is git-ignored.

# Default provider: Google AI Studio (Gemini) via its OpenAI-compatible endpoint.
GEMINI_API_KEY=paste-your-key-here

# Run `python check_setup.py` once without this set: it lists the models your key can use.
# Then put the chat model id here (use the part after "models/").
LLM_MODEL=

# Optional: use any other OpenAI-compatible provider instead.
# LLM_API_KEY=
# LLM_BASE_URL=

# Optional (Day 5): a second, smaller vision-capable model so Part B compares two tiers.
LLM_MODEL_SMALL=
